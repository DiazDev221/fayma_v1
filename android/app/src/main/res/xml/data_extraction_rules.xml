<?xml version="1.0" encoding="utf-8"?>
<!--
  Règles de sauvegarde Android 12 et ultérieurs.

  « cloud-backup » alimente la sauvegarde Google Drive, restaurée après une
  réinstallation. « device-transfer » couvre le transfert vers un nouveau
  téléphone. Dans les deux cas, on inclut la base SQLite (dossier « file »),
  les préférences (nom de la boutique, identifiants) et le dossier des bases.

  Le dossier temporaire (cache) n'est jamais sauvegardé.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
